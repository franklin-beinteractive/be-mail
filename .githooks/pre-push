#!/bin/sh
# Reclaims disk space in the cargo build directory right after a release tag is
# pushed.
#
# Enable once per checkout: git config core.hooksPath .githooks
#
# The cleanup is detached and its output goes to a log, so pushing the tag (and
# with it the start of the release workflow) is never delayed by deleting tens
# of gigabytes. The hook always exits 0: a failed cleanup must never block a
# push.

pushes_release_tag=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/tags/v*) pushes_release_tag=1 ;;
	esac
done

[ "$pushes_release_tag" -eq 1 ] || exit 0

repo_root=$(git rev-parse --show-toplevel) || exit 0
script="$repo_root/scripts/clean-target.mjs"
[ -f "$script" ] || exit 0

# The build directory may be shared across repos (target-dir in
# ~/.cargo/config.toml), so only the script knows where it is; `--log` makes it
# write to <build dir>/clean-target.log itself.
echo "pre-push: release tag detected, cleaning the cargo build directory in the background"
echo "          log: clean-target.log in the build directory"

# No `--force`: if a build happens to be running the script bails and says so in
# the log, which is the right call - the next release, or `npm run clean:target`,
# picks the work up again.
(node "$script" --log >/dev/null 2>&1 &) </dev/null

exit 0
